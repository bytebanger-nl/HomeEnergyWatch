# systemd unit for a Raspberry Pi or other Linux machine.
#   sudo useradd --system --home /var/lib/hwlocal --create-home hwlocal
#   sudo cp hwlocal /usr/local/bin/
#   sudo cp deploy/hwlocal.service /etc/systemd/system/
#   sudo systemctl enable --now hwlocal
[Unit]
Description=HomeWizard local gateway
Wants=network-online.target
After=network-online.target

[Service]
User=hwlocal
Group=hwlocal
ExecStart=/usr/local/bin/hwlocal
Environment=HWLOCAL_DATA_DIR=/var/lib/hwlocal
Environment=HWLOCAL_INTERVAL=2s
# HTTPS with your own domain on port 443 (see README):
# Environment=HWLOCAL_DOMAIN=energie.example.nl
# Environment=HWLOCAL_ACME_EMAIL=you@example.nl
# Environment=HWLOCAL_HTTPS_ADDR=:443
# Environment=HWLOCAL_HTTP_ADDR=:80
# EnvironmentFile=/etc/hwlocal.env   # put CLOUDFLARE_API_TOKEN=... here (chmod 600)
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hwlocal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
